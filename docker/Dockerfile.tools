# versola-tools: generates auth.conf/central.conf/edge.conf (via
# scripts/gen-env.scala, answered "docker-local") plus compose.fragment.yml
# and nginx.conf, everything "versola bootstrap local <version>" (see
# versola-cli) needs to bring up a local stack with nothing but Docker.
#
# No scala-cli in this image. gen-env.scala is compiled ahead of time as a
# regular sbt module (see build.sbt's `tools` project, whose
# Compile/unmanagedSources points straight at scripts/gen-env.scala) and
# staged in CI the same way as auth/central/edge (`sbt tools/stage`, see
# ci-cd.yml's "Stage services for release images" step) -- this Dockerfile
# just copies that result onto a runtime, it doesn't build anything itself.
# gen-env.scala stays the single copy on disk either way -- not a
# duplicated snapshot that could drift, the property the previous version
# of this file's comments cared about; `scala-cli run scripts/gen-env.scala`
# (local dev, see develop.md) compiles that exact same file.
#
# The runtime used to be a custom jlink image on Alpine instead of a stock
# JRE (this is a one-shot bootstrap tool, not a long-lived service, so a
# full JRE was mostly wasted weight on modules gen-env.scala never
# touches). That stopped working once migrate-tool (see build.sbt) started
# shipping in this same image: `jdeps --print-module-deps` against
# migrate-tool's own dependency tree (ZIO, Flyway, the Postgres JDBC
# driver, HikariCP -- pulled in transitively via util/util-postgres, which
# also drag in things migrate-tool itself never touches, like the CEL
# evaluator and its own okhttp/okio dependency) hit a jar whose
# Automatic-Module-Name metadata jdeps couldn't resolve ("Module okio not
# found, required by okhttp3"), failing the build outright rather than
# just producing a larger-than-ideal module list. Rather than chase that
# down jar-by-jar (excluding CEL/JSON-schema/zio-http/OpenTelemetry from
# migrate-tool's classpath might fix this one, but nothing guarantees the
# next transitive dependency added to `util` won't break jdeps' module
# resolution the same way again), this now uses the same plain
# `eclipse-temurin:25-jre` auth/central/edge already use -- proven to work
# in this repo already, and no longer worth optimizing away for an image
# that runs briefly and infrequently.
#
# Pinned by digest, not a floating tag -- same reproducibility reasoning
# as auth/central/edge's Dockerfiles: this image is published per release
# tag and expected to still build the same way if an old tag is ever
# rebuilt. Same digest those three already use, not a coincidence -- one
# fewer base image to keep in sync.
FROM eclipse-temurin:25-jre@sha256:f19dbf0a22d0b3658fda48ce7d7181df05ad14bda151dd5ad12cc09d1451c70e

ARG VERSION=dev
ENV VERSION=${VERSION}

WORKDIR /opt/versola-tools

# Staged application (see ci-cd.yml) -- carved back out of .dockerignore's
# blanket `target/` exclusion for exactly this path. entrypoint.sh invokes
# the app directly via `java -cp 'lib/*' genEnv` rather than the
# sbt-native-packager launcher at bin/tools -- that launcher's generated
# shebang is `#!/usr/bin/env bash`, and this base image (like auth/
# central/edge's) has no bash either, only /bin/sh -- lib/ is used
# directly instead, bin/tools is simply unused here, no need to chmod or
# otherwise touch it.
COPY scripts/target/universal/stage .
# MigrateTool's jars go in their own directory, not merged into lib/ above --
# gen-env.scala's `tools` sbt project deliberately excludes Dependencies.core
# (see build.sbt's comment on that project) to keep its own classpath lean,
# while migrate-tool pulls in the full ZIO/Flyway/Postgres stack; merging the
# two risks silently shadowing one jar's classes with another's under a
# colliding name. Kept separate, entrypoint.sh's "migrate" branch below
# points `-cp` at this directory specifically, `lib/*` (for genEnv) is
# untouched.
COPY migrate-tool/target/universal/stage/lib migrate-lib
# Each service's own Flyway migrations, bundled together so migrate-tool can
# apply all three schemas from this one image (see MigrateTool.scala's own
# comment on why `migrationLocations` has to be passed explicitly rather
# than relying on auto-detection once more than one service's migrations
# share a filesystem). Same relative shape auth/central/edge's own images
# already use for their own single migrations directory (see
# Dockerfile.auth/.central/.edge), just rooted at /opt/versola-tools
# instead of /app.
COPY auth/implementations/postgres/migrations auth/implementations/postgres/migrations
COPY central/implementations/postgres/migrations central/implementations/postgres/migrations
COPY edge/implementations/postgres/migrations edge/implementations/postgres/migrations
COPY docker/versola-tools/nginx.conf.template .
COPY docker/versola-tools/compose.fragment.yml.template .
COPY docker/versola-tools/compose.fragment.vps.yml.template .
# Was missing from this Dockerfile before this rewrite, even though
# entrypoint.sh has always copied it through to $OUT_DIR -- a pre-existing
# gap, not something introduced here; fixed while this file was already
# being touched.
COPY docker/versola-tools/proxy_params.conf.template .
COPY docker/versola-tools/openbao.hcl.template .
COPY docker/versola-tools/openbao.hcl.vps.template .
COPY docker/versola-tools/entrypoint.sh .
RUN chmod +x entrypoint.sh

# Smoke-test the actual staged app against this runtime during `docker
# build`, the same way the old scala-cli version did -- so a broken build
# fails loudly here instead of only surfacing the first time someone runs
# "versola bootstrap local" or "versola configure vps". Both
# non-interactive targets are exercised, not just docker-local, since
# vps's branch of gen-env.scala (Postgres password/admin bootstrap
# password placeholders, host-network URL defaults) is new code this same
# build could just as easily break. Output discarded -- gen-env.scala
# generates fresh random secrets/keys every run, and every real
# deployment needs its own, not whatever got baked in here.
RUN printf 'docker-local\n' | java -cp 'lib/*' genEnv && rm -rf .local
# AUTH_URL has no sensible default (it's the deploying party's own
# domain -- see gen-env.scala's requiredEnv), so vps's branch now
# requires it to even run. A placeholder is fine here: this is a smoke
# test, not a real deployment, and its output is discarded either way
# (see the comment above).
RUN printf 'vps\n' | AUTH_URL=https://smoke-test.invalid POSTGRES_HOST=127.0.0.1:5432 java -cp 'lib/*' genEnv && rm -rf .local

ENTRYPOINT ["./entrypoint.sh"]

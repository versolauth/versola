# versola-gateway: nginx + central-ui's static build baked into one image,
# so the deployment story stays "just Docker" without a separate
# container, a separate download step, or new hosting infrastructure for
# central-ui's files. Expects `npm run build` to have already been run in
# central-ui/ (a CI build step, not something this Dockerfile does itself,
# to keep the image simple and avoid needing Node in the build context).
#
# vite.config.ts bakes a relative BASE_PATH into every asset URL in
# dist/index.html, so the same dist/ resolves correctly at whatever path it's
# mounted under. This image mounts it at /central/admin/ -- the path
# EDGE_SESSION's cookie scope (and central-api.ts's default 'prefix' console
# mode) assumes -- rather than the docroot root.
#
# Routing (nginx.conf) is still supplied at runtime, not baked in here --
# see versola-cli/versola-tools' nginx.conf.template and
# nginx/envs/*/versola.conf. Only the static files are fixed per release;
# where traffic gets routed differs by deployment target (docker-local vs
# prod) and shouldn't be tied to this image's version.
#
# Stock nginx already does `try_files $uri $uri/ =404` and serves
# index.html for directory requests by default -- no custom nginx.conf
# needed in this image itself, only the files.
#
# 1.30 (stable), not 1.27: the official image ships ngx_http_acme_module
# (nginx's own Let's Encrypt client) since 1.29.1, which vps uses for TLS
# -- see entrypoint.sh's acme.conf.template in versola-tools. It's a
# dynamic module, so it has to be loaded in nginx.conf's main context;
# conf.d/ (where our config is mounted) is inside `http`, too late for
# load_module. Loading it unconditionally is harmless where no
# acme_issuer is configured (docker-local, vps behind an external proxy).
FROM nginx:1.30-alpine

RUN sed -i '1i load_module modules/ngx_http_acme_module.so;' /etc/nginx/nginx.conf

COPY central-ui/dist /usr/share/nginx/html/central/admin

# Generated by versola-tools -- not meant to be hand-edited.
#
# The vps counterpart to openbao.hcl.template -- same storage/listener
# shape, but a different bind address, for a reason specific to vps: this
# container runs with `network_mode: host` (see
# compose.fragment.vps.yml.template), which has no Docker port-publish step
# to restrict exposure on the other side the way docker-local's
# "127.0.0.1:8200:8200" does. With host networking, whatever this listener
# binds to IS the VPS's own bind, directly -- 0.0.0.0 here would put this
# unauthenticated-transport, TLS-disabled listener on the VPS's public
# interface, reachable from the whole internet, not just the VPS itself.
# 127.0.0.1 is safe specifically because network_mode: host means this
# container's loopback interface already IS the VPS's own loopback -- the
# CLI, running directly on the VPS (typically over SSH -- see deploy.md),
# reaches it exactly the same way a native process would.

storage "file" {
  path = "/openbao/file"
}

listener "tcp" {
  address     = "127.0.0.1:8200"
  tls_disable = true
}

# tls_disable is only safe because nothing outside this host can ever
# reach this listener -- see the address comment above.
api_addr      = "http://127.0.0.1:8200"
disable_mlock = true

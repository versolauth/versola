# Generated by versola-tools ${VERSION} -- not meant to be hand-edited.
# "versola bootstrap" places this next to auth.conf/central.conf/edge.conf/
# nginx.conf and runs it as-is; the relative paths below resolve against
# whatever directory this file itself ends up in, not the caller's cwd.
#
# central/auth/edge/nginx set "platform: linux/amd64" -- these images are
# only published for amd64 (see the CI jobs that build them), so on an
# Apple Silicon Mac Docker would otherwise have to guess whether to run
# them under emulation, which it doesn't always do predictably. Being
# explicit here means it always emulates instead of erroring or behaving
# oddly. This is a deliberate simplification for local dev, not a "we
# didn't know" gap -- native arm64 images were evaluated and intentionally
# deferred (this only runs locally; not worth the added CI complexity).
# postgres is left alone -- its official image already publishes arm64,
# so forcing amd64 there would only make it slower for no reason.

services:
  postgres:
    image: postgres:18
    container_name: versola-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: versola
      POSTGRES_PASSWORD: versola
      POSTGRES_DB: auth
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U versola -d auth"]
      interval: 5s
      timeout: 5s
      retries: 10
    # No host port published -- nothing outside this compose project needs
    # to reach Postgres directly, and publishing 5432 is exactly what
    # caused a real "port already allocated" conflict during manual
    # testing on a machine that already ran its own Postgres.

  central:
    image: ghcr.io/versolauth/versola-central:${VERSION}
    platform: linux/amd64
    container_name: versola-central
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      PORT: 8090
      DPORT: 8091
      CONFIG_PATH: /app/config/env.conf
    volumes:
      - ./central.conf:/app/config/env.conf:ro
    ports:
      # Only the diagnostic port (readiness) is published, not 8090 itself
      # -- nginx is still the only path to real traffic. "versola
      # bootstrap" polls this from the host to know when it's safe to
      # start auth/edge (see the comment on auth's depends_on below); it
      # can't do that without a published port, since it runs as a plain
      # process on the host, not inside this Compose network.
      - "8091:8091"

  auth:
    image: ghcr.io/versolauth/versola-auth:${VERSION}
    platform: linux/amd64
    container_name: versola-auth
    restart: unless-stopped
    # central has no healthcheck (no curl in eclipse-temurin:21-jre), so
    # this depends_on can only wait for "container started", not "actually
    # ready". If auth starts before central is really up, its startup
    # fails fatally ("Could not start application") -- but confirmed by
    # hand (docker inspect: RestartCount=0, Status=running, ExitCode=0)
    # that the JVM process does NOT exit when this happens, it just hangs
    # without ever binding its port. "restart: unless-stopped" can't save
    # this -- there's nothing for Docker to notice and restart. Whatever
    # starts this compose file MUST wait for central's readiness (e.g.
    # GET /readiness on its diagnostic port) before starting auth/edge,
    # the same two-stage sequence the manual bootstrap test used by hand.
    # Do not rely on Docker's restart policy to recover from this.
    depends_on:
      - central
    environment:
      PORT: 8080
      DPORT: 8081
      CONFIG_PATH: /app/config/env.conf
    volumes:
      - ./auth.conf:/app/config/env.conf:ro
    ports:
      - "8081:8081"

  edge:
    image: ghcr.io/versolauth/versola-edge:${VERSION}
    platform: linux/amd64
    container_name: versola-edge
    restart: unless-stopped
    depends_on:
      - central
    environment:
      PORT: 8095
      DPORT: 8096
      CONFIG_PATH: /app/config/env.conf
    volumes:
      - ./edge.conf:/app/config/env.conf:ro
    ports:
      - "8096:8096"

  # versola-gateway bakes central-ui's static build into an nginx image at
  # release time (see docker/Dockerfile.gateway in the versola repo) --
  # central-ui isn't its own service/container, just files nginx already
  # has. nginx.conf is still supplied by versola-tools like every other
  # env file below, not baked in -- routing needs to differ per deployment
  # target (docker-local vs prod), the static files don't.
  nginx:
    image: ghcr.io/versolauth/versola-gateway:${VERSION}
    platform: linux/amd64
    container_name: versola-nginx
    restart: unless-stopped
    depends_on:
      - auth
      - edge
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./proxy_params.conf:/etc/nginx/proxy_params.conf:ro
    ports:
      - "8080:8080"

# Generated by versola-tools ${VERSION} -- not meant to be hand-edited.
# "versola bootstrap" places this next to auth.conf/central.conf/edge.conf/
# nginx.conf and runs it as-is; the relative paths below resolve against
# whatever directory this file itself ends up in, not the caller's cwd.
#
# central/auth/edge/nginx set "platform: linux/amd64" -- these images are
# only published for amd64 (see the CI jobs that build them), so on an
# Apple Silicon Mac Docker would otherwise have to guess whether to run
# them under emulation, which it doesn't always do predictably. Being
# explicit here means it always emulates instead of erroring or behaving
# oddly. This is a deliberate simplification for local dev, not a "we
# didn't know" gap -- native arm64 images were evaluated and intentionally
# deferred (this only runs locally; not worth the added CI complexity).
# postgres is left alone -- its official image already publishes arm64,
# so forcing amd64 there would only make it slower for no reason.
#
# `name:` is set explicitly rather than left to Compose's default (derived
# from this file's parent directory) -- that directory is a fresh
# "bundle-<N>" every `configure` run (see state.Prepare in versola-cli), so
# leaving it implicit would make every run a *different* Compose project as
# far as Docker is concerned, even though it's the same deployment. Docker
# refuses to create a container under a fixed container_name (every service
# below has one) that already exists under a *different* project, so a
# second `configure`/`up` while the first run's containers are still up
# would fail on container-name conflicts instead of updating them in
# place -- and once the first run's bundle directory is gone (state.Prepare
# wipes it), nothing would even know those old containers exist anymore to
# stop them. A stable name fixes both: Compose looks containers up by
# project+service, not by which file path happened to describe them this
# time, so any bundle directory's compose file manages the same stack.
name: versola-local

services:
  # Secrets store. `versola configure` writes generated secrets here
  # (instead of into auth.conf/central.conf/edge.conf directly) and
  # auth/central/edge read them back via ${?VAR} substitution -- see
  # gen-env.scala's secretField and versola-cli's internal/deploy/secrets.go.
  openbao:
    image: openbao/openbao:2.5.4
    # Suffixed "-local", same reasoning as this file's own
    # versola-openbao-file-local volume just below: a shared name across
    # this file and compose.fragment.vps.yml.template would let a
    # container from one target mask the other's freshly created volume
    # on a machine that's run both (e.g. local dev testing before a real
    # vps deploy) -- switching targets would find "versola-openbao"
    # already running, leave it alone (see versola-cli's Configure), and
    # silently resolve secrets against the wrong target's OpenBao data
    # (flagged in review on versolauth/versola-cli#7).
    container_name: versola-openbao-local
    restart: unless-stopped
    command: ["server"]
    volumes:
      - ./openbao.hcl:/openbao/config/openbao.hcl:ro
      - versola-openbao-file-local:/openbao/file
    ports:
      # Published so the CLI (running on the host, not inside this Compose
      # network) can reach OpenBao's HTTP API directly to read/write
      # secrets -- everything else in this file only publishes a port
      # something outside the network genuinely needs (see central's 8091
      # comment below), same reasoning applies here.
      #
      # "127.0.0.1:8200:8200", not a bare "8200:8200": this listener has no
      # authentication on every endpoint (tls_disable, see
      # openbao.hcl.template) and no reason to ever be reached by anything
      # other than the CLI running on this same machine. A bare "8200:8200"
      # publishes it on every one of the host's network interfaces, not
      # just loopback -- reachable from the LAN, or the internet, on a
      # machine with a public IP. This is the host-side half of that fix;
      # openbao.hcl.template's listener itself still has to bind 0.0.0.0
      # for this publish to reach it at all -- see the comment there.
      - "127.0.0.1:8200:8200"

  postgres:
    image: postgres:18
    container_name: versola-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: versola
      POSTGRES_PASSWORD: versola
      POSTGRES_DB: auth
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U versola -d auth"]
      interval: 5s
      timeout: 5s
      retries: 10
    # No host port published -- nothing outside this compose project needs
    # to reach Postgres directly, and publishing 5432 is exactly what
    # caused a real "port already allocated" conflict during manual
    # testing on a machine that already ran its own Postgres.

  # Backs `versola migrate` (see versola-cli's internal/deploy/migrate.go),
  # which runs this via `docker compose run --rm migrate`. Applies each of
  # auth/central/edge's own Flyway migrations against its own schema from
  # one image (see docker/Dockerfile.tools and MigrateTool.scala) -- the
  # deliberate, reviewable step that used to be an implicit side effect of
  # starting a service (see central's own RUN_MIGRATIONS comment below).
  #
  # Deliberately no `container_name:` here, unlike every other service in
  # this file -- `docker compose run` creates its own one-off container
  # regardless, and a fixed name would only reintroduce the exact
  # orphaned-container/concurrent-run collision that versola-cli's old
  # MIGRATE_ONLY-based implementation had to work around by hand (checking
  # `docker.IsRunning` before an unconditional `docker rm -f`). Compose
  # already refuses to start a second `run` for the same one-off name at
  # once; nothing here needs to duplicate that.
  #
  # `depends_on: postgres: condition: service_healthy`, not a manual wait
  # loop -- `docker compose run` honours this the same way `up` does, so
  # invoking this service already blocks until Postgres's own healthcheck
  # (see postgres's own healthcheck above) passes, with no published port
  # needed to poll it from outside the network.
  migrate:
    image: ghcr.io/versolauth/versola-tools:${VERSION}
    platform: linux/amd64
    depends_on:
      postgres:
        condition: service_healthy
    # See gen-env.scala's pgUserDefault/pgPassDefault: docker-local's
    # Postgres user/password are fixed, non-secret literals (matching
    # postgres's own POSTGRES_USER/POSTGRES_PASSWORD above and what's
    # already written literally into auth.conf/central.conf/edge.conf's own
    # postgres blocks for this target) -- no OpenBao resolution needed here,
    # unlike vps's counterpart in compose.fragment.vps.yml.template.
    command: ["migrate"]
    volumes:
      - ./auth.conf:/opt/versola-tools/config/auth.conf:ro
      - ./central.conf:/opt/versola-tools/config/central.conf:ro
      - ./edge.conf:/opt/versola-tools/config/edge.conf:ro

  central:
    image: ghcr.io/versolauth/versola-central:${VERSION}
    platform: linux/amd64
    container_name: versola-central
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      PORT: 8090
      DPORT: 8091
      CONFIG_PATH: /app/config/env.conf
      # `versola up` assumes `versola migrate` already ran (see this
      # file's own `migrate` service, and versola-tools' migrate-tool
      # which backs it) -- this is NOT a duplicate safety net, it's the
      # whole point of splitting them: a schema change should get its
      # own explicit, reviewable step, not happen silently as a side
      # effect of starting the app.
      #
      # A skipped migrate still fails loudly at startup rather than
      # silently: "false" here means Flyway *validates* the schema
      # instead of applying to it (see PostgresHikariDataSource.layer's
      # own comment on that branch), so a missing migration surfaces
      # here, named, before this container ever passes readiness --
      # not later, on real traffic, at the first query against a table
      # that was never created.
      RUN_MIGRATIONS: "false"
    # Resolved by versola-cli against OpenBao, not written by this image --
    # central.conf's secret fields are ${?VAR} placeholders (see
    # gen-env.scala's secretField) that only resolve if the matching
    # variable actually exists in this container's environment.
    env_file:
      - ./central.secrets.env
    volumes:
      - ./central.conf:/app/config/env.conf:ro
    ports:
      # Only the diagnostic port (readiness) is published, not 8090 itself
      # -- nginx is still the only path to real traffic. "versola
      # bootstrap" polls this from the host to know when it's safe to
      # start auth/edge (see the comment on auth's depends_on below); it
      # can't do that without a published port, since it runs as a plain
      # process on the host, not inside this Compose network.
      - "8091:8091"

  auth:
    image: ghcr.io/versolauth/versola-auth:${VERSION}
    platform: linux/amd64
    container_name: versola-auth
    restart: unless-stopped
    # central has no healthcheck (no curl in eclipse-temurin:21-jre), so
    # this depends_on can only wait for "container started", not "actually
    # ready". If auth starts before central is really up, its startup
    # fails fatally ("Could not start application") -- but confirmed by
    # hand (docker inspect: RestartCount=0, Status=running, ExitCode=0)
    # that the JVM process does NOT exit when this happens, it just hangs
    # without ever binding its port. "restart: unless-stopped" can't save
    # this -- there's nothing for Docker to notice and restart. Whatever
    # starts this compose file MUST wait for central's readiness (e.g.
    # GET /readiness on its diagnostic port) before starting auth/edge,
    # the same two-stage sequence the manual bootstrap test used by hand.
    # Do not rely on Docker's restart policy to recover from this.
    depends_on:
      - central
    environment:
      PORT: 8080
      DPORT: 8081
      CONFIG_PATH: /app/config/env.conf
      # See central's own RUN_MIGRATIONS comment above.
      RUN_MIGRATIONS: "false"
    env_file:
      - ./auth.secrets.env
    volumes:
      - ./auth.conf:/app/config/env.conf:ro
    ports:
      - "8081:8081"

  edge:
    image: ghcr.io/versolauth/versola-edge:${VERSION}
    platform: linux/amd64
    container_name: versola-edge
    restart: unless-stopped
    depends_on:
      - central
    environment:
      PORT: 8095
      DPORT: 8096
      CONFIG_PATH: /app/config/env.conf
      # See central's own RUN_MIGRATIONS comment above.
      RUN_MIGRATIONS: "false"
    env_file:
      - ./edge.secrets.env
    volumes:
      - ./edge.conf:/app/config/env.conf:ro
    ports:
      - "8096:8096"

  # versola-gateway bakes central-ui's static build into an nginx image at
  # release time (see docker/Dockerfile.gateway in the versola repo) --
  # central-ui isn't its own service/container, just files nginx already
  # has. nginx.conf is still supplied by versola-tools like every other
  # env file below, not baked in -- routing needs to differ per deployment
  # target (docker-local vs prod), the static files don't.
  nginx:
    image: ghcr.io/versolauth/versola-gateway:${VERSION}
    platform: linux/amd64
    container_name: versola-nginx
    restart: unless-stopped
    depends_on:
      - auth
      - edge
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - ./proxy_params.conf:/etc/nginx/proxy_params.conf:ro
    ports:
      - "2821:2821"

# `external: true`, not a plain named volume: Compose namespaces ordinary
# named volumes under the *project* name, which defaults to the compose
# file's parent directory -- and that directory is a fresh "bundle-<N>"
# every `configure` run (see state.Prepare in versola-cli), specifically so
# repeated runs never collide on a reused host path. A plain named volume
# would inherit a different project name each run and silently start
# OpenBao from empty storage every time, exactly what this is meant to
# avoid (see the comment on openbao.hcl.template). `external: true` opts
# this one volume out of that namespacing -- it must already exist under
# this exact name before `docker compose up` runs (`docker volume create
# versola-openbao-file-local`, idempotent -- a no-op if it's already
# there; this is versola-cli's job, not something this template can do
# itself).
#
# Named "-local", not shared with compose.fragment.vps.yml.template's
# volume: `external: true` volumes are identified by name only, host-wide
# -- a shared name would mean a docker-local run and a real vps
# deployment could collide on the same OpenBao storage if they ever ran
# under the same Docker daemon (flagged in review; see versola-cli's
# OpenbaoVolumeName).
volumes:
  versola-openbao-file-local:
    external: true

# Generated by versola-tools ${VERSION} -- not meant to be hand-edited.
# The vps counterpart to compose.fragment.yml.template: auth/central/edge/
# openbao here, running on the real VPS itself (see deploy.md), not a
# throwaway local Docker Desktop setup. Two real differences from the
# docker-local fragment, both a direct consequence of that:
#
#   - No `postgres` service: the VPS's Postgres is a native systemd install
#     (see deploy.md), not something this CLI creates or owns. auth/
#     central/edge's postgres.url/user/password (see gen-env.scala's vps
#     branch) already point at it directly.
#
#   - No `nginx`/gateway service: the reverse proxy is not versola-tools'
#     business on vps. versola-cli generates its own proxy.yml (official
#     nginx image, config written by the CLI) and starts it in this same
#     Compose project -- see versola-cli's internal/proxy and deploy.md.
#
# Every remaining service runs with `network_mode: host` instead of
# Compose's default bridge network: the VPS's addressing (see
# gen-env.scala's vps branch -- 127.0.0.1 for internal calls) assumes
# containers share the host's network namespace the way native systemd
# services would, not that they reach each other via Compose service
# names. This also means no `ports:` mapping anywhere below -- with
# network_mode: host a container's ports already ARE the host's ports,
# and Compose rejects combining the two.
#
# `name:` is fixed for the same reason as compose.fragment.yml.template's
# -- see the comment there. Different value (versola-vps, not
# versola-local) so the two could never collide if this were ever run
# against the same Docker daemon, though in practice they never are: vps
# only ever runs on the one real VPS.
name: versola-vps

services:
  # Secrets store -- same role as in docker-local (see the comment there),
  # just also reachable at the VPS's own 127.0.0.1:8200 instead of a
  # published Docker Desktop port.
  openbao:
    image: openbao/openbao:2.5.4
    # Suffixed "-vps", same reasoning as compose.fragment.yml.template's
    # own container_name comment.
    container_name: versola-openbao-vps
    restart: unless-stopped
    network_mode: host
    command: ["server"]
    volumes:
      - ./openbao.hcl:/openbao/config/openbao.hcl:ro
      - versola-openbao-file-vps:/openbao/file

#@PG@  # ---- Bundled Postgres (POSTGRES_MODE=bundled) ------------------------------------------------------
#@PG@  # Only in a bundle generated with POSTGRES_MODE=bundled; in the default `external` mode every line
#@PG@  # marked like this one is dropped, so that bundle is the same file it always was. The role, the
#@PG@  # database and the three schemas are created by the image's first start (POSTGRES_USER/DB and
#@PG@  # postgres-init-schemas.sh) and never again: the image skips its init when the data directory is not
#@PG@  # empty. The password comes from postgres.secrets.env, which versola-cli writes with this one
#@PG@  # variable and nothing else of auth's secrets. `listen_addresses` is what keeps it off the public
#@PG@  # interface: with network_mode: host there is no `ports:` to restrict. The pinned tag is the
#@PG@  # PostgreSQL release the project verifies against; a major upgrade is not automatic.
#@PG@  postgres:
#@PG@    image: postgres:18.4@sha256:a02db8cac496f15b094798a38254f14d6e00741f709360e5e00bb6668ea31636
#@PG@    container_name: versola-postgres-vps
#@PG@    restart: unless-stopped
#@PG@    network_mode: host
#@PG@    env_file:
#@PG@      - ./postgres.secrets.env
#@PG@    environment:
#@PG@      POSTGRES_USER: "@POSTGRES_USER@"
#@PG@      POSTGRES_DB: "@POSTGRES_DB@"
#@PG@    # 150 connections: auth 10, central 15 and edge 10 pool connections (central and edge add a LISTEN connection
#@PG@    # each) per replica, the rollout's stand-ins, `migrate` and the reserved superuser slots. shared_buffers is
#@PG@    # sized for a server with 4 GB of RAM, where the three JVMs take most of the memory.
#@PG@    command:
#@PG@      - postgres
#@PG@      - -c
#@PG@      - listen_addresses=127.0.0.1
#@PG@      - -c
#@PG@      - max_connections=150
#@PG@      - -c
#@PG@      - shared_buffers=256MB
#@PG@    healthcheck:
#@PG@      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""]
#@PG@      # The first start runs initdb and the schema script before it accepts connections; failures in this
#@PG@      # window do not count, so a slow disk cannot make `depends_on: service_healthy` fail the `up`.
#@PG@      start_period: 30s
#@PG@      interval: 5s
#@PG@      timeout: 5s
#@PG@      retries: 12
#@PG@    volumes:
#@PG@      - versola-postgres-data-vps:/var/lib/postgresql
#@PG@      - ./postgres-init-schemas.sh:/docker-entrypoint-initdb.d/10-schemas.sh:ro
#@PG@
  # Backs `versola migrate` (see versola-cli's internal/deploy/migrate.go),
  # which runs this via `docker compose run --rm migrate`. Same role as
  # compose.fragment.yml.template's own `migrate` service -- see the long
  # comment there for why it deliberately has no `container_name:`.
  #
  # No `depends_on:` here, unlike the docker-local counterpart -- there is
  # no `postgres` service in this file to depend on (see the top-of-file
  # comment: vps's Postgres is a native systemd install this CLI doesn't
  # own or manage the lifecycle of, and is assumed already up).
  #
  # `network_mode: host`, same reasoning as every other service below --
  # $POSTGRES_HOST (see gen-env.scala's vps branch) is only ever resolved
  # into auth.conf/central.conf/edge.conf's own postgres.url at `configure`
  # time, not passed again here, so this only needs the same network
  # namespace those services already run in to reach it.
  migrate:
    image: ${REGISTRY}/versola-tools:${VERSION}
    # No `platform:` pin, same reasoning as central/auth/edge below.
    network_mode: host
    command: ["migrate"]
#@PG@    depends_on:
#@PG@      postgres:
#@PG@        condition: service_healthy
    # This one container mounts all three services' config files below and
    # resolves each in turn (see MigrateTool.readConnection) -- and Typesafe
    # Config's own resolve() requires every ${VAR} substitution in a config
    # document to resolve, not just the ones a given code path actually
    # reads. That means this needs every secret any of the three configs
    # placeholders out, not just postgres.password (the one field that's
    # the same value shared across all three, and the only one this used to
    # list a secrets file for -- auth.conf's and edge.conf's OWN secrets,
    # e.g. AUTH_CODES_SECRET, EDGE_PRIVATE_KEY, aren't in central.secrets.env
    # and were left unresolved by that, which is exactly what broke the
    # first real `versola migrate vps` run: ConfigException.
    # UnresolvedSubstitution on auth.conf's AUTH_CODES_SECRET).
    env_file:
      - ./auth.secrets.env
      - ./central.secrets.env
      - ./edge.secrets.env
    volumes:
      - ./auth.conf:/opt/versola-tools/config/auth.conf:ro
      - ./central.conf:/opt/versola-tools/config/central.conf:ro
      - ./edge.conf:/opt/versola-tools/config/edge.conf:ro
      - ./postgres-ca:/etc/versola/postgres-ca:ro

  central:
    image: ${REGISTRY}/versola-central:${VERSION}
    # No `platform:` pin here or on auth/edge below -- these images are
    # published as multi-arch manifest lists now, so Docker resolves them
    # natively on an arm64 VPS (Graviton/Ampere) instead of being forced
    # onto emulated amd64. Same change, same reasoning, as in
    # compose.fragment.yml.template -- see the comment at the top of it.
    container_name: versola-central
    restart: unless-stopped
    # The app's own graceful shutdown is bounded at 15s; Compose's default 10s
    # would SIGKILL a JVM still finishing requests.
    stop_grace_period: 20s
    network_mode: host
    environment:
      PORT: 8090
      DPORT: 8091
      CONFIG_PATH: /app/config/env.conf
      # #554: the edge surface, on central's own mutual-TLS listener. network_mode: host, so this
      # IS the VPS's port; it is bound to loopback, where the edge on this host reaches it. Nothing
      # else is published by default: a remote edge reaches it only through the public name that
      # `versola configure vps --central-mtls-domain` makes versola-cli's proxy forward to
      # 127.0.0.1:8093 (develop.md, "The edge surface on central"). The handshake demands a
      # certificate from the edge intermediate (edge-ca.crt, written by `mtls-init`) and
      # authorizeEdge a name for the edge the token names.
      MPORT: 8093
      MBIND_HOST: "127.0.0.1"
      # Central's APORT (not auth's, 8082: another container): the enrollment listener, which serves POST /edge/enroll and nothing else, so an edge that has no
      # certificate yet can get its first one with a one-time token. Plain HTTP on loopback
      # (BIND_HOST below); the TLS for `central.<domain>` is terminated by versola-cli's proxy in
      # front of it, and only when that name is configured.
      APORT: 8094
      # With `network_mode: host`, VersolaApp's own bind address IS the
      # VPS's bind, directly -- there's no Compose port-publish step to
      # restrict exposure the way docker-local's "127.0.0.1:PORT:PORT"
      # does (see openbao.hcl.template's comment for the same reasoning
      # applied to OpenBao). Without this, central -- which nothing
      # outside this host should ever reach at all -- would be open on
      # the VPS's public interface. See VersolaApp.bindHost's comment.
      BIND_HOST: "127.0.0.1"
      # See compose.fragment.yml.template's own RUN_MIGRATIONS comment.
      RUN_MIGRATIONS: "false"
    # Resolved by versola-cli against OpenBao, same as docker-local -- see
    # the comment on central's env_file in compose.fragment.yml.template.
    env_file:
      - ./central.secrets.env
    # `up -d central` is how versola-cli starts the stack, so this is what brings step-ca and
    # mtls-init up: central reads the CA they leave in versola-central-ca-vps at startup
    # (client-certificates.step-ca in central.conf) and exits without it.
    depends_on:
      mtls-init:
        condition: service_completed_successfully
#@PG@      postgres:
#@PG@        condition: service_healthy
    volumes:
      - ./central.conf:/app/config/env.conf:ro
      - ./postgres-ca:/etc/versola/postgres-ca:ro
      - versola-central-diagnostics-vps:/diagnostics
      # Also edge-ca.{crt,key}: central signs edge identities with the edge intermediate.
      - versola-central-ca-vps:/app/ca:ro
      # #554: central's listener certificate and the edge intermediate that vouches for edge certificates.
      - versola-mtls-vps:/app/mtls:ro

  auth:
    image: ${REGISTRY}/versola-auth:${VERSION}
    container_name: versola-auth
    restart: unless-stopped
    # The app's own graceful shutdown is bounded at 15s; Compose's default 10s
    # would SIGKILL a JVM still finishing requests.
    stop_grace_period: 20s
    # Same caveat as docker-local's auth: central has no healthcheck, so
    # this can only wait for "container started", not "actually ready" --
    # whatever starts this compose file must itself wait for central's
    # readiness before starting auth/edge. See the long comment on this in
    # compose.fragment.yml.template; it applies here unchanged.
    depends_on:
      central:
        condition: service_started
      mtls-init:
        condition: service_completed_successfully
#@PG@      postgres:
#@PG@        condition: service_healthy
    network_mode: host
    environment:
      PORT: 8080
      DPORT: 8081
      APORT: 8082
      # RFC 8705 §5's listener: served only if auth.conf carries a `mutual-tls` block, which
      # `configure` writes -- see deploy.md "Certificates for mutual TLS". It binds
      # BIND_HOST like everything else here, i.e. the VPS's loopback, which is where edge (also
      # network_mode: host) reaches it as https://127.0.0.1:8083. A public name for remote edges
      # and external mTLS clients is versola-cli's proxy forwarding to that loopback port.
      MPORT: 8083
      CONFIG_PATH: /app/config/env.conf
      # Same reasoning as central's BIND_HOST above. auth's actual public
      # path is through the VPS's native nginx, which already reaches it
      # via 127.0.0.1 (see deploy.md) -- not by connecting to auth's port
      # directly from outside, which is what a 0.0.0.0 bind here would
      # additionally allow, bypassing nginx's TLS/access control entirely.
      BIND_HOST: "127.0.0.1"
      RUN_MIGRATIONS: "false"
    env_file:
      - ./auth.secrets.env
    volumes:
      - ./auth.conf:/app/config/env.conf:ro
      - ./postgres-ca:/etc/versola/postgres-ca:ro
      - versola-auth-diagnostics-vps:/diagnostics
      - versola-mtls-vps:/app/mtls:ro

  edge:
    image: ${REGISTRY}/versola-edge:${VERSION}
    container_name: versola-edge
    restart: unless-stopped
    # The app's own graceful shutdown is bounded at 15s; Compose's default 10s
    # would SIGKILL a JVM still finishing requests.
    stop_grace_period: 20s
    depends_on:
      central:
        condition: service_started
      mtls-init:
        condition: service_completed_successfully
#@PG@      postgres:
#@PG@        condition: service_healthy
    network_mode: host
    environment:
      PORT: 8095
      DPORT: 8096
      CONFIG_PATH: /app/config/env.conf
      # Same reasoning as central's BIND_HOST above -- edge has no
      # separate public domain either (see gen-env.scala's vps branch:
      # edgeUrl equals authUrl), it's reached through nginx too.
      BIND_HOST: "127.0.0.1"
      RUN_MIGRATIONS: "false"
    env_file:
      - ./edge.secrets.env
    volumes:
      - ./edge.conf:/app/config/env.conf:ro
      - ./postgres-ca:/etc/versola/postgres-ca:ro
      - versola-edge-diagnostics-vps:/diagnostics
      - versola-mtls-vps:/app/mtls:ro

  # ---- Certificates for mutual TLS (#440) ---------------------------------------------------------
  # Three certificate relationships, each with its own rotation -- see develop.md "Certificate
  # storage and rotation". On by default: a small internal CA (smallstep step-ca) and a one-shot
  # `mtls-init` that signs auth's mutual-TLS listener certificate with it and hands central its
  # provisioner key -- central issues and renews edge-fronted clients' certificates through it.
  # auth.conf's `mutual-tls` block and edge.conf's `native` block already point at the files.
  step-ca:
    image: smallstep/step-ca:0.28.4
    container_name: versola-step-ca
    restart: unless-stopped
    network_mode: host
    environment:
      DOCKER_STEPCA_INIT_NAME: "Versola Client CA"
      DOCKER_STEPCA_INIT_DNS_NAMES: "localhost,127.0.0.1"
      DOCKER_STEPCA_INIT_PROVISIONER_NAME: versola
      DOCKER_STEPCA_INIT_ADDRESS: "127.0.0.1:9000"
    volumes:
      - versola-step-ca-vps:/home/step
      - ./step-ca-intermediates.sh:/usr/local/bin/step-ca-intermediates.sh:ro
    # After the image's own init (which has written ca.json and the root with the `client`
    # intermediate), add the `server` and `edge` intermediates under the same root and the JWK
    # provisioner central signs client certificates through -- once, with a key only central is
    # given (see `mtls-init`), valid for at most 14 days a certificate -- then run the CA as the
    # image would. The CA itself keeps signing with the client intermediate; the other two are
    # only ever used offline by `mtls-init`.
    command:
      - /bin/sh
      - -ec
      - |
        # Keep the request's subject (the default template would rewrite it to the bare CN) and
        # restrict the certificate to client authentication. The subject is only as trustworthy
        # as the one party that can ask -- central, with its own provisioner key.
        mkdir -p /home/step/templates
        cat > /home/step/templates/client.tpl <<'TPL'
        {
          "subject": {{ toJson .Insecure.CR.Subject }},
          "sans": {{ toJson .SANs }},
          "keyUsage": ["digitalSignature"],
          "extKeyUsage": ["clientAuth"]
        }
        TPL
        if [ ! -f /home/step/secrets/central-provisioner.json ]; then
          step crypto jwk create /home/step/certs/central-provisioner.pub.json \
            /home/step/secrets/central-provisioner.json --kty EC --crv P-256 --use sig --no-password --insecure
          step ca provisioner add central --type JWK --public-key=/home/step/certs/central-provisioner.pub.json \
            --ca-config=/home/step/config/ca.json --x509-template=/home/step/templates/client.tpl --x509-max-dur=336h --x509-default-dur=336h
        fi
        sh /usr/local/bin/step-ca-intermediates.sh
        exec /usr/local/bin/step-ca --password-file /home/step/secrets/password /home/step/config/ca.json
    healthcheck:
      test: ["CMD-SHELL", "step ca health --ca-url https://127.0.0.1:9000 --root /home/step/certs/root_ca.crt"]
      interval: 3s
      timeout: 5s
      retries: 30

  # Issues and renews the mutual-TLS leaves into `versola-mtls-vps`, which the services mount as
  # /app/mtls: auth's and central's listener certificates (server intermediate, 90 days) and the
  # first local edge's identity (edge intermediate, 30 days). It runs on every `up` and finds the
  # files it already wrote valid: a leaf is only replaced when it is missing, a third of its life
  # or less is left, it does not verify against its intermediate (certificates of the single-CA
  # layout are re-issued that way) or it lacks a configured public name. Edge pins the two listener
  # leaves, so those are replaced in two steps through MTLS_INIT_PHASE=prepare and =commit, which
  # `versola certs renew` and `rollout` drive with `docker compose run --rm -e MTLS_INIT_PHASE=...
  # mtls-init`; `report` prints every certificate's expiry. The script is in the bundle
  # (mtls-init.sh) and its header is the full contract; develop.md ("Pin rotation") has the
  # procedure. The public names are opt-in and written by `configure` from versola-tools' own
  # environment; empty means none.
  mtls-init:
    image: smallstep/step-ca:0.28.4
    container_name: versola-mtls-init
    restart: "no"
    user: root
    depends_on:
      step-ca:
        condition: service_healthy
    network_mode: host
    environment:
      MTLS_DOMAIN: "@MTLS_DOMAIN@"
      CENTRAL_MTLS_DOMAIN: "@CENTRAL_MTLS_DOMAIN@"
      # Days the leaves live (365 when empty; 0 = unlimited, 100 years).
      MTLS_CERT_DAYS: "@MTLS_CERT_DAYS@"
    volumes:
      - versola-step-ca-vps:/home/step:ro
      - versola-mtls-vps:/mtls
      - versola-central-ca-vps:/central-ca
      - ./mtls-init.sh:/usr/local/bin/mtls-init.sh:ro
    entrypoint: ["/bin/sh", "-ec"]
    command:
      - |
        # What central needs to ask step-ca for client certificates: its provisioner key and the
        # root it validates the CA by. Its own volume, because the CA's volume holds the CA keys.
        cp /home/step/secrets/central-provisioner.json /central-ca/provisioner.json
        cp /home/step/certs/root_ca.crt /central-ca/root_ca.crt
        chmod 600 /central-ca/provisioner.json
        exec sh /usr/local/bin/mtls-init.sh

# Same external-volume reasoning as compose.fragment.yml.template -- see
# the comment there. Named "-vps", not shared with that file's own
# "-local" volume, for the same reason spelled out there: a shared name
# would let a docker-local run and this real deployment collide on the
# same OpenBao storage if they ever ran under the same Docker daemon.
volumes:
  versola-openbao-file-vps:
    external: true
  # See compose.fragment.yml.template's comment on these -- heap dump and GC
  # log, kept out of the container filesystem so ExitOnOutOfMemoryError's
  # restart cannot destroy the evidence.
  versola-central-diagnostics-vps:
  versola-auth-diagnostics-vps:
  versola-edge-diagnostics-vps:
  # step-ca's state, the listener and identity certificates (mtls-init writes them; the services
  # mount them), and central's access to the CA.
  versola-step-ca-vps:
  versola-central-ca-vps:
  versola-mtls-vps:
#@PG@  # The customer's data: created by versola-cli like OpenBao's volume, so `compose down --volumes` and
#@PG@  # uninstall cannot remove it.
#@PG@  versola-postgres-data-vps:
#@PG@    external: true

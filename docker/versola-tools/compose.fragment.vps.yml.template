# Generated by versola-tools ${VERSION} -- not meant to be hand-edited.
# The vps counterpart to compose.fragment.yml.template: auth/central/edge/
# openbao here, running on the real VPS itself (see deploy.md), not a
# throwaway local Docker Desktop setup. Two real differences from the
# docker-local fragment, both a direct consequence of that:
#
#   - No `postgres` service: the VPS's Postgres is a native systemd install
#     (see deploy.md), not something this CLI creates or owns. auth/
#     central/edge's postgres.url/user/password (see gen-env.scala's vps
#     branch) already point at it directly.
#
#   - No `nginx`/gateway service: the VPS's public nginx is deployed by a
#     separate pipeline (see the `nginx` repo's deploy workflow), outside
#     this CLI entirely -- it's the thing that already routes
#     id.versola.kz to auth/edge on the host, not something "versola
#     configure vps" stands up.
#
# Every remaining service runs with `network_mode: host` instead of
# Compose's default bridge network: the VPS's addressing (see
# gen-env.scala's vps branch -- 127.0.0.1 for internal calls) assumes
# containers share the host's network namespace the way native systemd
# services would, not that they reach each other via Compose service
# names. This also means no `ports:` mapping anywhere below -- with
# network_mode: host a container's ports already ARE the host's ports,
# and Compose rejects combining the two.
#
# `name:` is fixed for the same reason as compose.fragment.yml.template's
# -- see the comment there. Different value (versola-vps, not
# versola-local) so the two could never collide if this were ever run
# against the same Docker daemon, though in practice they never are: vps
# only ever runs on the one real VPS.
name: versola-vps

services:
  # Secrets store -- same role as in docker-local (see the comment there),
  # just also reachable at the VPS's own 127.0.0.1:8200 instead of a
  # published Docker Desktop port.
  openbao:
    image: openbao/openbao:2.5.4
    # Suffixed "-vps", same reasoning as compose.fragment.yml.template's
    # own container_name comment.
    container_name: versola-openbao-vps
    restart: unless-stopped
    network_mode: host
    command: ["server"]
    volumes:
      - ./openbao.hcl:/openbao/config/openbao.hcl:ro
      - versola-openbao-file-vps:/openbao/file

  # Backs `versola migrate` (see versola-cli's internal/deploy/migrate.go),
  # which runs this via `docker compose run --rm migrate`. Same role as
  # compose.fragment.yml.template's own `migrate` service -- see the long
  # comment there for why it deliberately has no `container_name:`.
  #
  # No `depends_on:` here, unlike the docker-local counterpart -- there is
  # no `postgres` service in this file to depend on (see the top-of-file
  # comment: vps's Postgres is a native systemd install this CLI doesn't
  # own or manage the lifecycle of, and is assumed already up).
  #
  # `network_mode: host`, same reasoning as every other service below --
  # $POSTGRES_HOST (see gen-env.scala's vps branch) is only ever resolved
  # into auth.conf/central.conf/edge.conf's own postgres.url at `configure`
  # time, not passed again here, so this only needs the same network
  # namespace those services already run in to reach it.
  migrate:
    image: ghcr.io/versolauth/versola-tools:${VERSION}
    platform: linux/amd64
    network_mode: host
    command: ["migrate"]
    # auth.conf/central.conf/edge.conf's postgres.password field is an
    # OpenBao-resolved ${?POSTGRES_PASSWORD} placeholder here (unlike
    # docker-local's literal value -- see gen-env.scala's secretField call
    # on that field), so it needs env_file the same way central's own
    # service does below. All three services' passwords are the one value
    # gen-env.scala generates and reuses (see pgPassDefault), so any one of
    # the three secrets files would do; central.secrets.env is picked
    # because central is already the first service this file starts.
    env_file:
      - ./central.secrets.env
    volumes:
      - ./auth.conf:/opt/versola-tools/config/auth.conf:ro
      - ./central.conf:/opt/versola-tools/config/central.conf:ro
      - ./edge.conf:/opt/versola-tools/config/edge.conf:ro

  central:
    image: ghcr.io/versolauth/versola-central:${VERSION}
    # No `platform:` pin here or on auth/edge below -- these images are
    # published as multi-arch manifest lists now, so Docker resolves them
    # natively on an arm64 VPS (Graviton/Ampere) instead of being forced
    # onto emulated amd64. Same change, same reasoning, as in
    # compose.fragment.yml.template -- see the comment at the top of it.
    container_name: versola-central
    restart: unless-stopped
    network_mode: host
    environment:
      PORT: 8090
      DPORT: 8091
      CONFIG_PATH: /app/config/env.conf
      # With `network_mode: host`, VersolaApp's own bind address IS the
      # VPS's bind, directly -- there's no Compose port-publish step to
      # restrict exposure the way docker-local's "127.0.0.1:PORT:PORT"
      # does (see openbao.hcl.template's comment for the same reasoning
      # applied to OpenBao). Without this, central -- which nothing
      # outside this host should ever reach at all -- would be open on
      # the VPS's public interface. See VersolaApp.bindHost's comment.
      BIND_HOST: "127.0.0.1"
      # See compose.fragment.yml.template's own RUN_MIGRATIONS comment.
      RUN_MIGRATIONS: "false"
    # Resolved by versola-cli against OpenBao, same as docker-local -- see
    # the comment on central's env_file in compose.fragment.yml.template.
    env_file:
      - ./central.secrets.env
    volumes:
      - ./central.conf:/app/config/env.conf:ro

  auth:
    image: ghcr.io/versolauth/versola-auth:${VERSION}
    container_name: versola-auth
    restart: unless-stopped
    # Same caveat as docker-local's auth: central has no healthcheck, so
    # this can only wait for "container started", not "actually ready" --
    # whatever starts this compose file must itself wait for central's
    # readiness before starting auth/edge. See the long comment on this in
    # compose.fragment.yml.template; it applies here unchanged.
    depends_on:
      - central
    network_mode: host
    environment:
      PORT: 8080
      DPORT: 8081
      CONFIG_PATH: /app/config/env.conf
      # Same reasoning as central's BIND_HOST above. auth's actual public
      # path is through the VPS's native nginx, which already reaches it
      # via 127.0.0.1 (see deploy.md) -- not by connecting to auth's port
      # directly from outside, which is what a 0.0.0.0 bind here would
      # additionally allow, bypassing nginx's TLS/access control entirely.
      BIND_HOST: "127.0.0.1"
      RUN_MIGRATIONS: "false"
    env_file:
      - ./auth.secrets.env
    volumes:
      - ./auth.conf:/app/config/env.conf:ro

  edge:
    image: ghcr.io/versolauth/versola-edge:${VERSION}
    container_name: versola-edge
    restart: unless-stopped
    depends_on:
      - central
    network_mode: host
    environment:
      PORT: 8095
      DPORT: 8096
      CONFIG_PATH: /app/config/env.conf
      # Same reasoning as central's BIND_HOST above -- edge has no
      # separate public domain either (see gen-env.scala's vps branch:
      # edgeUrl equals authUrl), it's reached through nginx too.
      BIND_HOST: "127.0.0.1"
      RUN_MIGRATIONS: "false"
    env_file:
      - ./edge.secrets.env
    volumes:
      - ./edge.conf:/app/config/env.conf:ro

# Same external-volume reasoning as compose.fragment.yml.template -- see
# the comment there. Named "-vps", not shared with that file's own
# "-local" volume, for the same reason spelled out there: a shared name
# would let a docker-local run and this real deployment collide on the
# same OpenBao storage if they ever ran under the same Docker daemon.
volumes:
  versola-openbao-file-vps:
    external: true

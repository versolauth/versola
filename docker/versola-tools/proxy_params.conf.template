# Shared proxy_pass settings, included by every proxying `location` block in
# nginx.conf.template instead of repeating these six lines in each one.
#
# No ${VERSION} placeholder here either, same reasoning as nginx.conf.template
# -- copied as-is by entrypoint.sh rather than run through sed.

proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header Connection "";

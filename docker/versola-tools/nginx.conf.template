# Copied from versola-cli/manual-test/nginx/versola.local.conf, where it
# was verified against the real auth/central/edge images (proxying
# confirmed to behave identically to hitting auth directly, port for
# port). Adapted from nginx/envs/dev/versola.conf (the id.versola.kz
# server block only -- the marketing/blog/docs sites don't apply locally).
#
# Two changes from the prod config, everything else is the same routing
# logic on purpose:
#
#   1. No TLS. Prod terminates HTTPS itself; locally there's no
#      certificate and no domain, so this just listens on plain HTTP.
#      Port 2821 matches what "versola doctor" checks is free -- chosen
#      deliberately over 8080, which collides with enough other local dev
#      tooling to be worth avoiding.
#   2. Upstreams point at container DNS names (auth, edge) instead of
#      127.0.0.1 -- nginx is its own container here, not sharing the
#      host's network with auth/edge like it does in prod.
#
# central-ui isn't an upstream at all, here or in prod: it's static files
# nginx serves directly. Locally that means this nginx IS
# ghcr.io/versolauth/versola-gateway (see docker/Dockerfile.gateway in the
# versola repo), which already has central-ui's build baked in at
# /usr/share/nginx/html/central/admin -- the location block below just
# needs a matching `root`, no proxy, no separate container.
#
# central itself has no upstream here, same as prod -- the admin console
# talks to it only through edge's /resources/central/* proxy below.
#
# No ${VERSION} placeholder in this file -- routing doesn't change between
# Versola releases the way image tags do, so this is copied as-is by
# entrypoint.sh rather than run through sed.

upstream auth_backend {
    server auth:8080;
    keepalive 32;
}

upstream edge_backend {
    server edge:8095;
    keepalive 32;
}

server {
    listen 2821;
    server_name localhost;

    client_max_body_size 8m;

    location = /admin {
        return 301 /central/admin/$is_args$args;
    }

    location /admin/ {
        rewrite ^/admin/(.*)$ /central/admin/$1 permanent;
    }

    location = /central {
        return 301 /central/admin/$is_args$args;
    }

    location = /central/ {
        return 301 /central/admin/$is_args$args;
    }

    location = /central/admin {
        return 301 /central/admin/$is_args$args;
    }

    # `root` (not `alias`): the request path /central/admin/... is appended
    # as-is to /usr/share/nginx/html, landing on
    # /usr/share/nginx/html/central/admin/... -- exactly where
    # Dockerfile.gateway copies central-ui's dist/, and exactly what
    # vite.config.ts bakes into every asset URL in dist/index.html. No
    # rewrite, no separate container.
    location /central/admin/ {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /central/permissions/me {
        proxy_pass http://edge_backend/permissions/me;
        include proxy_params.conf;
    }

    location /central/ {
        rewrite ^/central/(.*)$ /resources/central/$1 break;

        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location = /resources {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location /resources/ {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location = /permissions {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location /permissions/ {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    # OAuth2 / OIDC core endpoints -- these already fall through to the
    # catch-all below since it also points at auth_backend, but are listed
    # explicitly here for clarity/documentation of the surface.
    location = /authorize {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location = /token {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location = /introspect {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location = /revoke {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location = /userinfo {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location /.well-known/ {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    # /challenge is the conversation/login-form step API (email, phone,
    # password, otp, passkey, set-password submissions all nest under it).
    location = /challenge {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location /challenge/ {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location = /login {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location /login/ {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location = /complete {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location = /complete/ {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    # Bare /logout is auth's RP-initiated logout / end_session_endpoint --
    # hit directly by RPs, and by the browser after edge's redirect below.
    location = /logout {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    # /logout/{presetId} (preset-scoped, edge-initiated logout) and
    # /logout/frontchannel, /logout/backchannel (OIDC front/back-channel
    # logout notifications from auth) all live on edge, same as /login/.
    location /logout/ {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    # Everything else stays on auth (OIDC endpoints, login forms, etc.)
    location / {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }
}

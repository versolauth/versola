# Copied from versola-cli/manual-test/nginx/versola.local.conf, where it
# was verified against the real auth/central/edge images (proxying
# confirmed to behave identically to hitting auth directly, port for
# port). Adapted from nginx/envs/dev/versola.conf (the id.versola.kz
# server block only -- the marketing/blog/docs sites don't apply locally).
#
# Two changes from the prod config, everything else is the same routing
# logic on purpose:
#
#   1. No TLS in this file. Locally there's no certificate and no domain,
#      so docker-local listens on plain HTTP on 2821 -- chosen over 8080,
#      which collides with enough other local dev tooling to be worth
#      avoiding. The actual `listen` line is generated per target, see the
#      include in the server block below.
#   2. Upstreams are not in this file -- see the include just below.
#
# central-ui isn't an upstream at all, here or in prod: it's static files
# nginx serves directly. Locally that means this nginx IS
# ghcr.io/versolauth/versola-gateway (see docker/Dockerfile.gateway in the
# versola repo), which already has central-ui's build baked in at
# /usr/share/nginx/html/central/admin -- the location block below just
# needs a matching `root`, no proxy, no separate container.
#
# central itself has no upstream here, same as prod -- the admin console
# talks to it only through edge's /resources/central/* proxy below.
#
# No ${VERSION} placeholder in this file -- routing doesn't change between
# Versola releases the way image tags do, so this is copied as-is by
# entrypoint.sh rather than run through sed.

# Upstreams live in their own file, one per target (upstreams.conf.template
# for docker-local, upstreams.vps.conf.template for vps), picked by
# entrypoint.sh. The routing below is identical on both targets; only where
# auth/edge are reachable differs (container DNS names vs 127.0.0.1 under
# network_mode: host). Keeping them apart also means scaling replicas later
# only has to rewrite this one small file and reload, not the routing.
include /etc/nginx/versola-upstreams.conf;

# Real client IP when this gateway sits behind another reverse proxy on
# the same host (vps `--proxy external`: the host's own nginx terminates
# TLS and forwards to us over 127.0.0.1). Without this, $remote_addr --
# and so the X-Real-IP proxy_params.conf sends on, which auth uses by
# default for IP-based throttling (OAuthConfigurationService.getIpHeader)
# -- would be 127.0.0.1 for every request, collapsing per-IP limits into
# one shared bucket.
#
# Only a proxy at 127.0.0.1 is trusted to supply X-Forwarded-For, and
# only its last entry (the address it saw) is taken (real_ip_recursive
# off) -- anything a client wrote into the header itself is ignored. When
# nothing sits in front (docker-local, or vps owning 80/443 itself) the
# peer is never 127.0.0.1, so this changes nothing there.
set_real_ip_from 127.0.0.1;
real_ip_header X-Forwarded-For;

server {
    # Generated by entrypoint.sh per target/proxy mode: 2821 on
    # docker-local, 80 on vps owning the host's ports itself, 127.0.0.1:2821
    # on vps behind another reverse proxy (PROXY_MODE=external).
    include /etc/nginx/versola-listen.conf;
    server_name localhost;

    client_max_body_size 8m;

    location = /admin {
        return 301 /central/admin/$is_args$args;
    }

    location /admin/ {
        rewrite ^/admin/(.*)$ /central/admin/$1 permanent;
    }

    location = /central {
        return 301 /central/admin/$is_args$args;
    }

    location = /central/ {
        return 301 /central/admin/$is_args$args;
    }

    location = /central/admin {
        return 301 /central/admin/$is_args$args;
    }

    # `root` (not `alias`): the request path /central/admin/... is appended
    # as-is to /usr/share/nginx/html, landing on
    # /usr/share/nginx/html/central/admin/... -- exactly where
    # Dockerfile.gateway copies central-ui's dist/, and exactly what
    # vite.config.ts bakes into every asset URL in dist/index.html. No
    # rewrite, no separate container.
    location /central/admin/ {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache" always;
    }

    location = /central/permissions/me {
        proxy_pass http://edge_backend/permissions/me;
        include proxy_params.conf;
    }

    location /central/ {
        rewrite ^/central/(.*)$ /resources/central/$1 break;

        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location = /resources {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location /resources/ {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location = /permissions {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location /permissions/ {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    # OAuth2 / OIDC core endpoints -- these already fall through to the
    # catch-all below since it also points at auth_backend, but are listed
    # explicitly here for clarity/documentation of the surface.
    location = /authorize {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location = /token {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location = /introspect {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location = /revoke {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location = /userinfo {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location /.well-known/ {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    # /challenge is the conversation/login-form step API (email, phone,
    # password, otp, passkey, set-password submissions all nest under it).
    location = /challenge {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location /challenge/ {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    location = /login {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location /login/ {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location = /complete {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    location = /complete/ {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    # Bare /logout is auth's RP-initiated logout / end_session_endpoint --
    # hit directly by RPs, and by the browser after edge's redirect below.
    location = /logout {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }

    # /logout/{presetId} (preset-scoped, edge-initiated logout) and
    # /logout/frontchannel, /logout/backchannel (OIDC front/back-channel
    # logout notifications from auth) all live on edge, same as /login/.
    location /logout/ {
        proxy_pass http://edge_backend;
        include proxy_params.conf;
    }

    # Everything else stays on auth (OIDC endpoints, login forms, etc.)
    location / {
        proxy_pass http://auth_backend;
        include proxy_params.conf;
    }
}

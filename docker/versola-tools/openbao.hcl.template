# Generated by versola-tools -- not meant to be hand-edited.
#
# File storage keeps sealed/unsealed data in the "openbao-file" named volume
# (see compose.fragment.yml.template), not inside the per-run bundle
# directory this file itself lands in. Unlike auth.conf/central.conf/
# edge.conf, this has to survive `configure` re-runs: every other file
# versola-tools writes gets replaced with a fresh copy each run, but this
# one -- and the volume it points at -- must not be, or every `configure`
# would start OpenBao from empty storage and force every secret still
# referenced by a live session to be regenerated.

storage "file" {
  path = "/openbao/file"
}

listener "tcp" {
  # 0.0.0.0, not 127.0.0.1: this listener has to be reachable on the
  # container's own bridge-network interface for Compose's "8200:8200"
  # port publish to work at all -- Docker's port forwarding rewrites the
  # destination to that interface's real IP, not loopback, and a socket
  # bound only to 127.0.0.1 inside the container would never see those
  # packets. The actual exposure this would otherwise cause (this
  # unauthenticated-transport, TLS-disabled listener reachable from
  # anywhere that can reach the host, not just the host itself) is closed
  # on the other side instead: compose.fragment.yml.template's ports entry
  # publishes it as "127.0.0.1:8200:8200", restricting which of the HOST's
  # interfaces Docker accepts the connection on in the first place, not
  # which of the container's interfaces this listener answers on.
  #
  # This isn't vps's file -- see openbao.hcl.vps.template, which doesn't
  # have this constraint (network_mode: host has no publish step to do the
  # restricting on the other side) and binds 127.0.0.1 directly instead.
  address     = "0.0.0.0:8200"
  tls_disable = true
}

# tls_disable is only safe because nothing outside this host can ever
# reach this listener in the first place -- see the address comment above.
api_addr      = "http://127.0.0.1:8200"
disable_mlock = true

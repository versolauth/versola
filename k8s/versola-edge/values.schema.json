{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "versola-edge chart values",
  "type": "object",
  "required": ["central", "config", "secrets"],
  "properties": {
    "replicaCount": {"const": 1, "description": "One token enrolls one identity; see values.yaml."},
    "central": {
      "type": "object",
      "required": ["mtlsUrl", "pins", "enrollment"],
      "properties": {
        "mtlsUrl": {"type": "string", "pattern": "^https://[^/ ]+$", "description": "https://<central-mtls host>, no path."},
        "pins": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "BEGIN CERTIFICATE"}},
        "enrollment": {
          "type": "object",
          "required": ["url"],
          "properties": {
            "url": {"type": "string", "pattern": "^https://[^/ ]+$"}
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "mtlsUrl": {"type": "string", "pattern": "^$|^https://[^/ ]+$"},
        "pins": {"type": "array", "items": {"type": "string", "pattern": "BEGIN CERTIFICATE"}}
      }
    }
  }
}

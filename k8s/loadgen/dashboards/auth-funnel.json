{
  "uid": "versola-auth-funnel",
  "title": "Versola — auth funnel",
  "description": "auth's own business counters, as distinct from the SUT RED board's transport-level http_server_* metrics: whether a login actually authenticated, not just whether the HTTP call succeeded. Metric names and label sets come from auth/src/main/scala/versola/oauth/AuthMetrics.scala — `outcome`/`reason`/`kind`/`step`/`result` are that file's own enums, not reproduced here, so read them there rather than guessing from a legend. namespace and job are scrape-time labels, as on every other board.",
  "tags": [
    "versola",
    "auth"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(auth_authorize_total, namespace)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      },
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(auth_authorize_total{namespace=\"$namespace\"}, job)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "What this board reads",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "auth's own business counters, as distinct from the SUT RED board's transport-level http_server_* metrics: whether a login actually authenticated, not just whether the HTTP call succeeded. Metric names and label sets come from auth/src/main/scala/versola/oauth/AuthMetrics.scala — `outcome`/`reason`/`kind`/`step`/`result` are that file's own enums, not reproduced here, so read them there rather than guessing from a legend. namespace and job are scrape-time labels, as on every other board."
      }
    },
    {
      "type": "timeseries",
      "title": "Authorize outcomes",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (rate(auth_authorize_total{namespace=\"$namespace\", job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "description": "Every /authorize decision auth reaches, by its own outcome label — see AuthMetrics.scala for the enum.",
      "id": 2,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Authorize rejections by reason",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (rate(auth_authorize_total{namespace=\"$namespace\", job=~\"$job\", outcome!=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "description": "Same counter, split by `reason` and filtered to outcome!=\"success\" -- the label auth carries only the failed decisions to explain.",
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Conversations started vs completed, by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (rate(auth_conversation_started_total{namespace=\"$namespace\", job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ],
      "description": "login/step_up/reauth, per AuthMetrics.scala. Compare against the matching series on auth_conversation_completed_total below -- a started line with no matching completed line is an abandoned conversation, not a failed one, so it never appears on the outcomes panel.",
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "timeseries",
      "title": "Conversations completed, by kind",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind) (rate(auth_conversation_completed_total{namespace=\"$namespace\", job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      }
    },
    {
      "type": "timeseries",
      "title": "Conversation steps by step and result",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (step, result) (rate(auth_conversation_step_total{namespace=\"$namespace\", job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{step}} {{result}}"
        }
      ],
      "description": "Every factor challenge along the way (otp submit, password submit, passkey assertion, ...), by AuthMetrics.scala's own `step`/`result` pair -- this is where a single factor failing disproportionately shows up, upstream of the conversation-level outcome above.",
      "id": 6,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      }
    }
  ]
}

{
  "name": "@versola/admin-ui",
  "version": "1.0.0",
  "description": "Versola Central UI - OAuth 2.0 & OpenID Connect Admin Dashboard",
  "type": "module",
  "main": "dist/versola-admin.js",
  "module": "dist/versola-admin.js",
  "exports": {
    ".": "./dist/versola-admin.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build:forms": "node scripts/build-forms.mjs",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "test:ui": "npx playwright test",
    "test:ui:headed": "npx playwright test --headed",
    "test:unit": "vitest run",
    "docs:screenshots": "npx playwright test --project docs",
    "docs:screenshots:sync": "node scripts/sync-docs-screenshots.mjs",
    "design:contrast": "node design-system/contrast.mjs"
  },
  "keywords": [
    "oauth",
    "openid-connect",
    "admin",
    "web-components",
    "lit"
  ],
  "author": "Versola",
  "license": "SEE LICENSE IN ../LICENCE.md",
  "dependencies": {
    "@marcbachmann/cel-js": "^8.0.0",
    "@types/prismjs": "^1.26.6",
    "libphonenumber-js": "^1.13.15",
    "lit": "^3.2.1",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "babel-preset-solid": "^1.9.16",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}

# Postgres with TLS switched on: the one Postgres the unit tests run against (a server with ssl=on still
# accepts plaintext connections, which is what the specs other than PostgresTlsConnectionSpec use). The certificates are generated by
# start.sh at the moment of building -- nothing secret is committed -- and exist only to be
# trusted by that spec through POSTGRES_TLS_CA.
FROM postgres:18
COPY --chown=postgres:postgres --chmod=600 server.key /var/lib/postgresql/tls/server.key
COPY --chown=postgres:postgres --chmod=644 server.crt /var/lib/postgresql/tls/server.crt
USER postgres
CMD ["postgres", "-c", "max_connections=200", "-c", "ssl=on", "-c", "ssl_cert_file=/var/lib/postgresql/tls/server.crt", "-c", "ssl_key_file=/var/lib/postgresql/tls/server.key"]

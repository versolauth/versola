# Postgres with TLS switched on: the one Postgres the unit tests and local services run against.
# A server with ssl=on still accepts plaintext connections, which is what every spec other than
# PostgresTlsConnectionSpec uses. The certificates are generated by tls-entrypoint.sh at start --
# nothing secret is committed -- and exist only to be trusted by that spec through POSTGRES_TLS_CA.
FROM postgres:18
COPY --chmod=755 tls-entrypoint.sh /usr/local/bin/tls-entrypoint.sh
ENTRYPOINT ["tls-entrypoint.sh"]
CMD ["postgres", "-c", "max_connections=200", "-c", "shared_buffers=512MB", \
     "-c", "ssl=on", \
     "-c", "ssl_cert_file=/var/lib/postgresql/tls/server.crt", \
     "-c", "ssl_key_file=/var/lib/postgresql/tls/server.key"]

{
  "uid": "versola-loadgen",
  "title": "Versola load generator",
  "description": "The campaign as the emulator sees it: arrival and exchange rates, the refresh:code ratio against the target profile, the emulator's own health, and the mock backend. Read the Versola board for the system under test.",
  "tags": [
    "versola",
    "versola-loadgen"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "utc",
  "links": [
    {
      "type": "dashboards",
      "title": "Services",
      "tags": [
        "versola-service"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(loadgen_campaign_info, namespace)",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Campaign",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "`loadgen_campaign_info` carries `campaign`, `tenant`, `profile` and `token_mode`. The report (`GET /report/<campaign>`) states the same ratio as `refreshToCodeRatio`, counted over the measured phases only."
      },
      "transparent": true,
      "id": 2,
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Refresh : code ratio",
      "description": "Refresh exchanges per authorization-code exchange over the selected time range (token-refresh steps over token-code steps, every scenario, every outcome). The target profile is 5 to 10 (versolauth/versola#591); below 5 is red, above 10 yellow. The range includes warm-up and ramp phases; the report's refreshToCodeRatio is the measured phases only.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 5
              },
              {
                "color": "#EAB839",
                "value": 10
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(loadgen_step_duration_seconds_count{namespace=\"$namespace\", step=\"token-refresh\"}[$__range])) / clamp_min(sum(increase(loadgen_step_duration_seconds_count{namespace=\"$namespace\", step=\"token-code\"}[$__range])), 1)",
          "instant": false
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 3
      }
    },
    {
      "type": "stat",
      "title": "Code exchanges / s",
      "description": "token-code steps: mobile logins, step-ups and the native-via-edge exchange.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(loadgen_step_duration_seconds_count{namespace=\"$namespace\", step=\"token-code\"}[$__rate_interval]))",
          "instant": false
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 6,
        "y": 3
      }
    },
    {
      "type": "stat",
      "title": "Refresh exchanges / s",
      "description": "token-refresh steps: a resumed mobile session, the planned `session.refresh-count` refreshes and the TTL-gated one.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(loadgen_step_duration_seconds_count{namespace=\"$namespace\", step=\"token-refresh\"}[$__rate_interval]))",
          "instant": false
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 10,
        "y": 3
      }
    },
    {
      "type": "stat",
      "title": "Arrivals / s",
      "description": "Sessions started, all scenarios.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(loadgen_arrivals_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "instant": false
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 3,
        "w": 4,
        "x": 14,
        "y": 3
      }
    },
    {
      "type": "stat",
      "title": "Schedule lag",
      "description": "How far behind its schedule the slowest driver is. Above 250 ms the emulator, not the system, is adding to the latencies.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(loadgen_schedule_lag_seconds{namespace=\"$namespace\"})",
          "instant": false
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 3,
        "w": 3,
        "x": 18,
        "y": 3
      }
    },
    {
      "type": "stat",
      "title": "Driver CPU",
      "description": "The busiest driver's CPU as a share of its allocation. Above 40% the client's own queueing starts to show in the latencies.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.4
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(loadgen_driver_cpu_ratio{namespace=\"$namespace\"})",
          "instant": false
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 3,
        "w": 3,
        "x": 21,
        "y": 3
      }
    },
    {
      "type": "timeseries",
      "title": "Refresh and code exchanges / s",
      "description": "The two rates the ratio is made of. At the target profile the refresh line sits 5 to 10 times above the code line.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(loadgen_step_duration_seconds_count{namespace=\"$namespace\", step=\"token-refresh\"}[$__rate_interval]))",
          "legendFormat": "token-refresh"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(loadgen_step_duration_seconds_count{namespace=\"$namespace\", step=\"token-code\"}[$__rate_interval]))",
          "legendFormat": "token-code"
        }
      ],
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Refresh : code ratio",
      "description": "The same ratio over time. A campaign below 5 does not exercise the refresh path at the target profile: raise `session.refresh-count.mobile-mean`. The dashed lines mark 5 and 10.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:×",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 5
              },
              {
                "color": "#EAB839",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(loadgen_step_duration_seconds_count{namespace=\"$namespace\", step=\"token-refresh\"}[$__rate_interval])) / clamp_min(sum(rate(loadgen_step_duration_seconds_count{namespace=\"$namespace\", step=\"token-code\"}[$__rate_interval])), 0.001)",
          "legendFormat": "refresh / code"
        }
      ],
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Exchanges / s by scenario",
      "description": "Where the code and refresh exchanges come from: the mobile logins, step-up, and the refresh scenario.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (scenario, step) (rate(loadgen_step_duration_seconds_count{namespace=\"$namespace\", step=~\"token-code|token-refresh\"}[$__rate_interval]))",
          "legendFormat": "{{scenario}} {{step}}"
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "title": "Refresh rejected / s",
      "description": "Refreshes the system refused (token revoked, expired or replayed). The report allows none; each ends the session.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (rate(loadgen_refresh_rejected_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      }
    },
    {
      "id": 13,
      "type": "row",
      "title": "Load",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "type": "timeseries",
      "title": "Arrivals / s by scenario",
      "description": "Sessions started per scenario, the open-model schedule the campaign was asked to hold.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (scenario) (rate(loadgen_arrivals_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{scenario}}"
        }
      ],
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "title": "Steps / s by outcome",
      "description": "Every step by its taxonomy bucket. ok, stepup, forbidden and unauthorized are planned branches; transport, unexpected_status and malformed consume the error budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (rate(loadgen_outcomes_total{namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      }
    },
    {
      "type": "timeseries",
      "title": "Step latency p99",
      "description": "Measured from the intended start of the step, so a driver that falls behind shows it. The /token p99 target is 120 ms.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, step) (rate(loadgen_step_duration_seconds_bucket{namespace=\"$namespace\", step=~\"token-code|token-refresh|action\"}[$__rate_interval])))",
          "legendFormat": "{{step}}"
        }
      ],
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 31
      }
    },
    {
      "type": "timeseries",
      "title": "Flow latency p99",
      "description": "Whole flows (a login, a refresh, a step-up, a business action) rather than single hops.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le, flow) (rate(loadgen_flow_duration_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{flow}}"
        }
      ],
      "id": 17,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      }
    },
    {
      "type": "timeseries",
      "title": "Users busy and requests in flight",
      "description": "Concurrency the emulator is holding against the system.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(loadgen_busy_users{namespace=\"$namespace\"})",
          "legendFormat": "users in a session"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(loadgen_inflight_requests{namespace=\"$namespace\"})",
          "legendFormat": "requests in flight"
        }
      ],
      "id": 18,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      }
    },
    {

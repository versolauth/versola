{
  "uid": "versola-ingress",
  "title": "Versola — Ingress",
  "description": "The front door: ingress-nginx traffic, errors and latency for the selected environment. Empty if another controller fronts the services.",
  "tags": [
    "versola",
    "versola-service"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "utc",
  "links": [
    {
      "type": "dashboards",
      "title": "Services",
      "tags": [
        "versola-service"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "env",
        "label": "Env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(up{app_kubernetes_io_component=~\"auth|central|edge\"}, environment)",
        "refresh": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(nginx_ingress_controller_requests, exported_namespace)",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0
      },
      {
        "name": "tail",
        "label": "Tail quantile",
        "type": "custom",
        "query": "p99 : 0.99, p99.9 : 0.999, p99.99 : 0.9999, p99.999 : 0.99999",
        "current": {
          "text": "p99",
          "value": "0.99",
          "selected": true
        },
        "options": [
          {
            "text": "p99",
            "value": "0.99",
            "selected": true
          },
          {
            "text": "p99.9",
            "value": "0.999",
            "selected": false
          },
          {
            "text": "p99.99",
            "value": "0.9999",
            "selected": false
          },
          {
            "text": "p99.999",
            "value": "0.99999",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Requests/s",
      "description": "Requests the ingress controller answers for this environment's Ingress objects, any status.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(nginx_ingress_controller_requests{exported_namespace=\"$namespace\"}[$__rate_interval]))",
          "instant": false
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Server errors",
      "description": "Share of requests answered 5xx at the front door: the services failing or unreachable (502/503/504). Yellow from 0.1%, red from 1%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(nginx_ingress_controller_requests{exported_namespace=\"$namespace\", status=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(nginx_ingress_controller_requests{exported_namespace=\"$namespace\"}[$__rate_interval])), 0.001)",
          "instant": false
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Latency ${tail:text}",
      "description": "Whole request as the ingress sees it, from the first byte of the request to the last byte of the response, at the quantile chosen in Tail quantile. Includes slow clients.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile($tail, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{exported_namespace=\"$namespace\"}[$__rate_interval])))",
          "instant": false
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Upstream latency ${tail:text}",
      "description": "Time the service behind the ingress took to answer, at the chosen quantile. The gap to the request latency is the network and the client.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile($tail, sum by (le) (rate(nginx_ingress_controller_response_duration_seconds_bucket{exported_namespace=\"$namespace\"}[$__rate_interval])))",
          "instant": false
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 18,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Client closed (499) / s",
      "description": "Requests the client abandoned before the answer came: timeouts on the client side. A burst here with a calm server is the signature of a slow or overloaded client, or a network problem.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.1
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(nginx_ingress_controller_requests{exported_namespace=\"$namespace\", status=\"499\"}[$__rate_interval]))",
          "instant": false
        }
      ],
      "id": 6,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 0,
        "y": 4
      }
    },
    {
      "type": "stat",
      "title": "Active connections",
      "description": "Open client connections across controller pods.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(nginx_ingress_controller_nginx_process_connections{state=\"active\"})",
          "instant": false
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 6,
        "y": 4
      }
    },
    {
      "type": "stat",
      "title": "Config reload",
      "description": "1 = the last configuration reload succeeded on every controller pod. 0 means the controller is running an older configuration than the cluster describes.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min(nginx_ingress_controller_config_last_reload_successful)",
          "instant": false
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 12,
        "y": 4
      }
    },
    {
      "type": "stat",
      "title": "Certificate expires in",
      "description": "Soonest certificate expiry across hosts served by the controller. Red below a week.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 604800
              },
              {
                "color": "green",
                "value": 1814400
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min(nginx_ingress_controller_ssl_expire_time_seconds) - time()",
          "instant": false
        }
      ],
      "id": 9,
      "gridPos": {
        "h": 3,
        "w": 6,
        "x": 18,
        "y": 4
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Traffic and errors",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Requests / s by status class",
      "description": "2xx and 3xx are service; 4xx is callers (401 is part of the DPoP and token handshakes); 5xx is the service or the path to it failing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (class) (label_replace(rate(nginx_ingress_controller_requests{exported_namespace=\"$namespace\"}[$__rate_interval]), \"class\", \"${1}xx\", \"status\", \"(.)..\"))",
          "legendFormat": "{{class}}"
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Requests / s by service",
      "description": "Which backend Service the ingress sent the requests to.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (rate(nginx_ingress_controller_requests{exported_namespace=\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Errors / s (4xx and 5xx) by service and status",
      "description": "Which failures, from which service. 499 is the client giving up; 502/503/504 is the service not answering.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service, status) (rate(nginx_ingress_controller_requests{exported_namespace=\"$namespace\", status=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{status}}"
        }
      ],
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "type": "timeseries",
      "title": "Server errors (5xx) share by service",
      "description": "Per service, the share of its requests answered 5xx at the ingress.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (service) (rate(nginx_ingress_controller_requests{exported_namespace=\"$namespace\", status=~\"5..\"}[$__rate_interval])) / clamp_min(sum by (service) (rate(nginx_ingress_controller_requests{exported_namespace=\"$namespace\"}[$__rate_interval])), 0.001)",
          "legendFormat": "{{service}}"
        }
      ],
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Latency",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      }
    },
    {
      "type": "timeseries",
      "title": "Request latency",
      "description": "Whole request as the ingress sees it, p50, p95, p99 and the selected Tail quantile. p99.99 needs roughly 10 000 requests in the rate window to mean anything and p99.999 roughly 100 000; both are rounded up to the histogram bucket edge.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{exported_namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{exported_namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{exported_namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p99"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(histogram_quantile($tail, sum by (le) (rate(nginx_ingress_controller_request_duration_seconds_bucket{exported_namespace=\"$namespace\"}[$__rate_interval])))) and on() (vector($tail) > 0.99)",
          "legendFormat": "${tail:text}"
        }
      ],
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 25
      }
    },
    {
      "type": "timeseries",
      "title": "Upstream (service) latency",
      "description": "Time the backend took to answer, p50, p95, p99 and the selected Tail quantile. Compare with the request latency above: the gap is the network and the client. p99.99 needs roughly 10 000 requests in the rate window to mean anything and p99.999 roughly 100 000; both are rounded up to the histogram bucket edge.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
